class Solution {
    public int countDigitOccurrences(int[] nums, int digit) {
        
        StringBuilder b=new StringBuilder();

        for(int i=0;i<nums.length;i++){
            b.append(nums[i]);
        }
        String s=b.toString();
        char m= (char) (digit+'0');
        int count=0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(c==m){
                count++;
            }
        }
        return count;
    }
}
