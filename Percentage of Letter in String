class Solution {
    public int percentageLetter(String s, char letter) {
        
        int count=0;
        char l= (char) letter;

        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);

            if(c==l){
                count++;
            }
        }

        int sum= ((count*100)/s.length());

        return sum;
    }
}
