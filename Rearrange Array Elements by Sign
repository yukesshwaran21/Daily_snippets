class Solution {
    public int[] rearrangeArray(int[] nums) {

        List<Integer> l1=new ArrayList<>();
        List<Integer> l2=new ArrayList<>();
        int[] arr=new int[nums.length];
        
        for(int i=0;i<nums.length;i++){
            if(nums[i]>0){
                l1.add(nums[i]);
            }
            else{
                l2.add(nums[i]);
            }
        }
        int p=0,n=0;
        for(int i=0;i<arr.length;i++){
            if(i%2==0){
                arr[i]=l1.get(p);
                p++;
            }
            else{
                arr[i]=l2.get(n);
                n++;
            }
        }
        return arr;
    }
}
