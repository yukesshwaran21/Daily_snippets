class Solution {
    public int countPartitions(int[] nums) {
        int sum=0;
        for(int i=0;i<nums.length;i++){
            sum+=nums[i];
        }
        int lsum=0,c=0,rsum=0;
        for(int i=0;i<nums.length-1;i++){
            lsum += nums[i];
            rsum = sum-lsum;
            if((rsum-lsum)%2==0){
                c++;
            }
        }
        return c;
    }
}
