class Solution {
    public int partitionString(String s) {
        HashSet<Character> set = new HashSet<>();
        int partitions = 1;

        for (char ch : s.toCharArray()) {

            if (set.contains(ch)) {
                partitions++;
                set.clear();
            }

            set.add(ch);
        }

        return partitions;
    }
}
