class Solution {
    public int[] diStringMatch(String s) {
        
        int I=0,D=s.length();
        List<Integer> l=new ArrayList<>();
        
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);

            if(c=='I'){
                l.add(I++);
            }
            else{
                l.add(D--);
            }
          }
          l.add(I);
          int arr[]=new int[l.size()];
          for(int i=0;i<l.size();i++){
            arr[i]=l.get(i);
          }
            return arr;
        }
    }
