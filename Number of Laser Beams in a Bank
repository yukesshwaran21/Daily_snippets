class Solution {
    public int numberOfBeams(String[] bank) {
        int sum=0;
        int prev=0;
        for(String s:bank){
            int c=0;

            for(char v:s.toCharArray()){
                if(v=='1'){
                    c++;
                }
            }

            if(c==0) continue;

            sum += prev*c;
            prev=c;
        }
        return sum;
    }
}
