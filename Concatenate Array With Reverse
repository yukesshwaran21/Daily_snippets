class Solution {
    public int[] concatWithReverse(int[] nums) {
        
        int arr[]=new int[nums.length+nums.length];

        for(int i=0;i<arr.length;i++){
            if(i<(arr.length/2)){
                arr[i]=nums[i];
            }
            else{
                arr[i]=nums[arr.length-i-1];
            }
        }
        return arr;
    }
}
