class Solution {
    public int[] findDegrees(int[][] matrix) {
        
        List<Integer> l=new ArrayList<>();
        for(int i=0;i<matrix.length;i++){
            int count=0;
            for(int j=0;j<matrix.length;j++){
                if(matrix[i][j]==1){
                    count++;
                }
            }
            l.add(count);
        }
        int arr[]=new int[l.size()];
        int n=0;
        for(int i=0;i<arr.length;i++){
            arr[n++]=l.get(i);
        }
        return arr;
    }
}
