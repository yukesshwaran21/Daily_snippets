class Solution {
    public boolean isBalanced(String num) {
        
        int sum1=0,sum2=0;
        for(int i=0;i<num.length();i++){
            int d=num.charAt(i)-'0';
            if(i%2==0){
                sum1+=d;
            }else{
                sum2+=d;
            }
        }
        if(sum1==sum2){
            return true;
        }
        return false;
    }
}
