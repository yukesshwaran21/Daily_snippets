class Solution {
    public String convertDateToBinary(String date) {
        
        String arr[]=date.split("-");
        StringBuilder b=new StringBuilder();
        for(int i=0;i<arr.length;i++){
            int c=Integer.parseInt(arr[i]);
            String sum="";
            while(c>0){
                int d=c%2;
                sum = d+sum;
                c=c/2;
            }
            b.append(sum);
        
            if(arr.length-1!=i){
                b.append("-");
            }
        }
        return b.toString();
    }
}
