class Solution {
    public int countKeyChanges(String s) {
        
        int c=0;
        for(int i=0;i<s.length()-1;i++){
            char c1 = Character.toLowerCase(s.charAt(i));
            char c2 = Character.toLowerCase(s.charAt(i + 1));

            if (c1 != c2) {
                c++;
            }
        }
        return c;
    }
}
