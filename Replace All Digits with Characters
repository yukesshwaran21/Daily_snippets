class Solution {
    public String replaceDigits(String s) {
        
        StringBuilder b= new StringBuilder();

        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(Character.isLetter(c)){
                b.append(c);
            }
            else{
                int j=c-'0';
                char v= s.charAt(i-1);
                b.append((char)(v+j));
            }
        }
        return b.toString();
    }
}
