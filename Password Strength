class Solution {
    public int passwordStrength(String password) {

        int sum=0;
        Set<Character> s=new HashSet<>();
        for(char c:password.toCharArray()){
            s.add(c);
        }
        
        for(char c:s){
            if(Character.isUpperCase(c)){
                sum += 2;
            }
            else if(Character.isLowerCase(c)){
                sum += 1;
            }
            else if(Character.isDigit(c)){
                sum += 3;
            }
            else{
                sum += 5;
            }
        }
        return sum;
    }
}
