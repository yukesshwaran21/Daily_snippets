class Solution {
    public int maxFrequencyElements(int[] nums) {
        
        HashMap<Integer,Integer> m=new HashMap<>();

        for(int i:nums){
            m.put(i,m.getOrDefault(i,0)+1);
        }

        int max=Integer.MIN_VALUE;

        for(int i:m.keySet()){
            if(max<m.get(i)){
                max=m.get(i);
            }
        }
        int c=0;
        for(int i:m.keySet()){
            if(m.get(i)==max){
                c+=max;
            }
        }
        return c;
    }
}
