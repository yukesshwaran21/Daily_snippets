class Solution {
    public int minElement(int[] nums) {
        
        List<Integer> l=new ArrayList<>();

        for(int i=0;i<nums.length;i++){
            int n=nums[i];
            int sum=0;
            if(n>=10){
                while(n>0){
                    int d=n%10;
                    sum += d;
                    n /= 10;
                }
                l.add(sum);
            }else{
                l.add(n);
            }
        }
        Collections.sort(l);
        return l.get(0);
    }
}
