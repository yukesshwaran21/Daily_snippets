class Solution {
    public int differenceOfSum(int[] nums) {
        
        int sum1=0;
        int sum2=0;

        for(int i=0;i<nums.length;i++){
            sum1 += nums[i];
        }

        for(int i=0;i<nums.length;i++){
            int n=nums[i];

            if(n>=10){
                while(n>0){
                    int d=n%10;
                    sum2 += d;
                    n /= 10;
                }
            }else{
                sum2 += n;
            }
        }
        return sum1-sum2;
    }
}
