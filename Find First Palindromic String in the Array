class Solution {
    public String firstPalindrome(String[] words) {
        
        for(int i=0;i<words.length;i++){
            String s=words[i];
            String temp=s;

            String rev = "";

            for(int j = s.length() - 1; j >= 0; j--){
                rev = rev + s.charAt(j);
            }

            if(rev.equals(s)){
                return s;
            }
        }
        return "";
    }
}
