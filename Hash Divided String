class Solution {
    public String stringHash(String s, int k) {
        
       
        StringBuilder b=new StringBuilder();
        for(int i=0;i<s.length();i+=k){
            String v= s.substring(i,Math.min(i+k,s.length()));
            int sum=0;
            for(char c: v.toCharArray()){
               sum += (c-'a'+0);
            }
            char c=(char)('a' + (sum%26));
            b.append(c);
        }
        return b.toString();
    }
}
