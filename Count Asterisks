class Solution {
    public int countAsterisks(String s) {
        
        String arr[]=s.split("\\|");
        int count=0;
        for(int i=0;i<arr.length;i++){
             if(i % 2 == 0){

                String v = arr[i];

                for(int j=0;j<v.length();j++){

                    char c = v.charAt(j);

                    if(c == '*'){

                        count++;
                    }
                }
            }
        }
    
        return count;
    }
}
