class Solution {
    public int[] runningSum(int[] nums) {
        
        int ar[]=new int[nums.length];
        int n=0;
        for(int i=0;i<nums.length;i++){
            int sum=0;
            for(int j=0;j<i+1;j++){
                sum+=nums[j];
            }
            ar[n++]=sum;
        }
        return ar;
    }
}
