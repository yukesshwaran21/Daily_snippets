class Solution {
    public int canBeTypedWords(String text, String brokenLetters) {
        
        String arr[]=text.split(" ");
        int count=0;
        for(String s:arr){
            boolean b=true;
            for(char c: brokenLetters.toCharArray()){
                if(s.contains(Character.toString(c))){
                    b=false;
                }
            }
            if(b){
                count++;
            }
        }
        return count;
    }
}
