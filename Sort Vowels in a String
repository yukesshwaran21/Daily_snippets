class Solution {
    public String sortVowels(String s) {
        List<Character> l=new ArrayList<>();

        for(char c:s.toCharArray()){
            if("AEIOUaeiou".contains(c+"")){
                l.add(c);
            }
        }
        Collections.sort(l);

        StringBuilder b=new StringBuilder();
        int i=0;
        for(char c:s.toCharArray()){
            if("AEIOUaeiou".contains(c+"")){
                b.append(l.get(i++));
            }
            else{
                b.append(c);
            }
        }
        return b.toString();
    }
}
