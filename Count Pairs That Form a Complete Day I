class Solution {
    public int countCompleteDayPairs(int[] hours) {
        
        int c=0;
        for(int i=0;i<hours.length;i++){
            int sum=0;
            for(int j=i+1;j<hours.length;j++){
                sum = hours[i]+hours[j];
                if(sum%24==0){
                    c++;
                }
            }
        }
        return c;
    }
}
