class Solution {
    public int minLength(String s) {
        
        boolean b=true;

        while(b){
            b=false;

            if(s.contains("AB")){
               s = s.replaceFirst("AB","");
                b=true;
            }

            if(s.contains("CD")){
                s = s.replaceFirst("CD","");
                b=true;
            }
        }

        return s.length();
    }
}
