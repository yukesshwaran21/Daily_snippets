class Solution {
    public int sumDivisibleByK(int[] nums, int k) {
        
        HashMap<Integer,Integer> m=new HashMap<>();

        for(int i:nums){
            m.put(i,m.getOrDefault(i,0)+1);
        }
        List<Integer> l=new ArrayList<>();
        for(int i:m.keySet()){
            if(m.get(i)%k==0){
                l.add(i);
            }
        }
        int sum=0;
        for(int i=0;i<nums.length;i++){
            for(int j=0;j<l.size();j++){
                if(nums[i]==l.get(j)){
                    sum+=nums[i];
                }
            }
        }
        return sum;
    }
}
