class Solution {
    public boolean halvesAreAlike(String s) {
        
        String s1=s.substring(0,s.length()/2);
        String s2=s.substring(s.length()/2,s.length());
        int c1=0,c2=0;
        for(int i=0;i<s1.length();i++){
            char d1=s1.charAt(i);
            char d2=s2.charAt(i);
            if("AEIOUaeiou".contains(Character.toString(d1))){
                c1++;
            }
            if("AEIOUaeiou".contains(Character.toString(d2))){
                c2++;
            }            
        }
        if(c1==c2){
            return true;
        }
        return false;
    }
}
