class Solution {
    public boolean hasSameDigits(String s) {
        
        
        while(s.length()>2){
        StringBuilder b=new StringBuilder();
        for(int i=0;i<s.length()-1;i++){
            int sum=0;
            char c1=s.charAt(i);
            char c2=s.charAt(i+1);

            int n1=c1 -'0';
            int n2=c2 - '0';

            sum = n1+n2;
            sum = sum%10;
            b.append(Integer.toString(sum));
           
        }
         s=b.toString();
        System.out.println(s);
        
        }
        return s.charAt(0) == s.charAt(1);
    }
}
