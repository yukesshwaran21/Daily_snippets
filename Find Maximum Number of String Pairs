class Solution {
    public int maximumNumberOfStringPairs(String[] words) {
        
        int c=0;

        for(int i=0;i<words.length;i++){
            char[] c1=words[i].toCharArray();
            Arrays.sort(c1);
            for(int j=i+1;j<words.length;j++){
                char[] c2=words[j].toCharArray();
                Arrays.sort(c2);
                if(Arrays.equals(c1,c2)){
                    c++;
                }
            }
        }
        return c;
    }
}
